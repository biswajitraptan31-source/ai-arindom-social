rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Signed-in users can find friends by the email they use for Neon X.
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      allow get, list: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        function isConversationMember() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow get, list: if isConversationMember();

        allow create: if isConversationMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.senderName is string
          && request.resource.data.createdAt is string;

        allow update, delete: if false;
      }
    }

    // Keep all other collections closed unless separately configured.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}